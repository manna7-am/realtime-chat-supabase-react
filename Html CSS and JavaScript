<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YBT Security Suite - Password & Network Manager</title>
    <style>
        :root {
            --primary: #2ecc71;
            --secondary: #27ae60;
            --dark: #2c3e50;
            --light: #ecf0f1;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui;
        }

        body {
            background: var(--light);
            color: var(--dark);
            line-height: 1.6;
            transition: var(--transition);
        }

        body.dark-mode {
            background: #34495e;
            color: var(--light);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .header {
            text-align: center;
            padding: 4rem 0;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border-radius: 0 0 2rem 2rem;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin: 3rem 0;
        }

        .feature-card {
            background: white;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: var(--transition);
        }

        .dark-mode .feature-card {
            background: #2c3e50;
        }

        .feature-card:hover {
            transform: translateY(-5px);
        }

        .download-section {
            text-align: center;
            margin: 4rem 0;
        }

        .btn {
            padding: 1rem 2rem;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.1rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn:hover {
            background: var(--secondary);
            transform: scale(1.05);
        }

        .theme-toggle {
            position: fixed;
            top: 1rem;
            right: 1rem;
            cursor: pointer;
            background: none;
            border: none;
            font-size: 1.5rem;
        }

        .password-checker {
            margin: 2rem 0;
            padding: 2rem;
            background: white;
            border-radius: 1rem;
        }

        .dark-mode .password-checker {
            background: #2c3e50;
        }
    </style>
</head>
<body>
    <button class="theme-toggle" onclick="toggleTheme()">🌙</button>
    
    <div class="header">
        <h1>YBT Security Suite</h1>
        <p>Professional Password & Network Management Solution</p>
    </div>

    <div class="container">
        <div class="password-checker">
            <h3>Password Strength Analyzer</h3>
            <input type="password" id="passwordInput" placeholder="Test password strength..." 
                   style="width: 100%; padding: 1rem; margin: 1rem 0;">
            <div id="strengthMeter"></div>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="emoji">✨</div>
                <h3>Advanced Password Analysis</h3>
                <p>Real-time strength evaluation with entropy calculation</p>
            </div>
            
            <div class="feature-card">
                <div class="emoji">🔍</div>
                <h3>Network Scanner</h3>
                <p>Detailed WiFi analysis and signal metrics</p>
            </div>

            <div class="feature-card">
                <div class="emoji">📤</div>
                <h3>Secure Export</h3>
                <p>Multiple formats with AES-256 encryption</p>
            </div>
        </div>

        <div class="download-section">
            <a href="https://github.com/YouBTech01/WiFi-Password-Cracker-Pro/releases/tag/WIFI-Crack-Release-1.0" 
               class="btn" download>
                ⬇️ Download for Windows
            </a>
            <p style="margin-top: 1rem;">Version 1.0 | 64-bit .exe</p>
        </div>
    </div>

    <script>
        // Theme Toggle
        function toggleTheme() {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');
        }

        // Password Strength Checker
        document.getElementById('passwordInput').addEventListener('input', function(e) {
            const password = e.target.value;
            const strength = calculateStrength(password);
            updateStrengthMeter(strength);
        });

        function calculateStrength(password) {
            let score = 0;
            if (password.length >= 8) score++;
            if (password.length >= 12) score++;
            if (/[A-Z]/.test(password)) score++;
            if (/[0-9]/.test(password)) score++;
            if (/[^A-Za-z0-9]/.test(password)) score++;
            return Math.min(score, 5);
        }

        function updateStrengthMeter(strength) {
            const meter = document.getElementById('strengthMeter');
            meter.innerHTML = `
                <div style="height: 5px; background: #eee; margin-top: 10px; border-radius: 3px;">
                    <div style="width: ${strength * 20}%; height: 100%; 
                        background: ${strength < 2 ? 'red' : strength < 4 ? 'orange' : 'var(--primary)'};
                        transition: var(--transition); border-radius: 3px;">
                    </div>
                </div>
                <div style="margin-top: 5px; font-size: 0.9em;">
                    Strength: ${['Very Weak', 'Weak', 'Moderate', 'Strong', 'Very Strong'][strength]}
                </div>
            `;
        }

        // Initialize theme
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-mode');
        }
    </script>
</body>
</html>
